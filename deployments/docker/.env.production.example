# Production environment variables
# Copy to .env.production and update values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
DATABASE_DSN=postgres://indexer:${DB_PASSWORD}@postgres:5432/indexer?sslmode=require
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=10m
DB_CONN_MAX_IDLE_TIME=5m

# Authentication
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=24h
SESSION_SECRET=${SESSION_SECRET}
SESSION_EXPIRY=7d

# Email (disabled by default in production - use SES or SendGrid)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# NNTP
NNTP_DEFAULT_MAX_CONNECTIONS=10
NNTP_DEFAULT_TIMEOUT=30s
NNTP_DEFAULT_RETRY_ATTEMPTS=3
NNTP_DEFAULT_RETRY_DELAY=2s

# Spotnet
SPOTNET_DEFAULT_TIMEOUT=30s
SPOTNET_DEFAULT_RETRY_ATTEMPTS=3
SPOTNET_DEFAULT_RETRY_DELAY=2s

# Observability
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_ENDPOINT=
LOG_LEVEL=info
LOG_FORMAT=json

# Backup
BACKUP_ENABLED=false
BACKUP_DIR=/backups
BACKUP_RETENTION=30d
